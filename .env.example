# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# Configure in AI Studio Secrets or Netlify Site Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Auto-detected from request headers / Netlify URL if omitted.
APP_URL="MY_APP_URL"

# Supabase backend connection for CraftCopy (kept server-side only).
# Accepts SUPABASE_URL / VITE_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY or SUPABASE_ANON_KEY / VITE_SUPABASE_ANON_KEY.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
# Preferred server-only key for Storage + Database operations (never prefix with VITE_):
# SUPABASE_SERVICE_ROLE_KEY=""
